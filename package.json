{
  "name": "cap4",
  "version": "1.0.0",
  "type": ".js",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credential": {
            "url": "db.sqlite"
          }
        }
      }
    }
  }
}